// quadchroma.rc - version info, program icon and application manifest of the
// Windows exe. client/build.rs compiles this file with rc.exe (Windows SDK)
// or llvm-rc; the version numbers and the manifest path are in
// quadchroma_version.h, which build.rs writes from Cargo.toml to OUT_DIR
// (included via /I).
#pragma code_page(65001)
#include "quadchroma_version.h"

// Constants from winver.h/winresrc.h, defined here directly: that way the
// file needs no SDK include path (INCLUDE) and also works with llvm-rc.
#define VS_VERSION_INFO                    1
#define VS_FFI_FILEFLAGSMASK               0x3F
#define VOS_NT_WINDOWS32                   0x40004
#define VFT_APP                            0x1
#define VFT2_UNKNOWN                       0x0
#define RT_MANIFEST                        24
#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1

// The program icon: Explorer shows the ICON resource with the lowest ID.
// The same .ico that logo.rs writes at run time (logo::ico(&ICO_GROESSEN));
// res/quadchroma.ico was generated from it.
1 ICON "quadchroma.ico"

// Application manifest (asInvoker, per-monitor DPI v2, long paths, UTF-8,
// Windows 10/11); build.rs fills in the template res/quadchroma.manifest.
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST QC_MANIFEST_PFAD

VS_VERSION_INFO VERSIONINFO
FILEVERSION     QC_VERSION_ZAHLEN
PRODUCTVERSION  QC_VERSION_ZAHLEN
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0409 = English (United States), 04B0 = Unicode (1200)
        BLOCK "040904B0"
        BEGIN
            // FileDescription is the name that Task Manager and the firewall
            // and SmartScreen dialogs show - hence short.
            VALUE "CompanyName",      "Robert Brandt"
            VALUE "FileDescription",  "QuadChroma"
            VALUE "FileVersion",      QC_VERSION_TEXT
            VALUE "InternalName",     "quadchroma"
            VALUE "LegalCopyright",   "© 2026 Robert Brandt"
            VALUE "OriginalFilename", "quadchroma.exe"
            VALUE "ProductName",      "QuadChroma"
            VALUE "ProductVersion",   QC_VERSION_TEXT
            VALUE "Comments",         "QuadChroma remote desktop (HEVC 4:4:4) - https://github.com/quadchroma-tech/quadchroma"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
