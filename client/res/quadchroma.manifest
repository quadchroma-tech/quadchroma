<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0"
          xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
  <!-- quadchroma.manifest: application manifest of the Windows exe. Template;
       client/build.rs fills in @VERSION@ (from Cargo.toml) and @ARCH@ (target)
       and embeds the file as RT_MANIFEST 1 via res/quadchroma.rc. -->
  <assemblyIdentity type="win32" name="tech.quadchroma.quadchroma" version="@VERSION@" processorArchitecture="@ARCH@"/>
  <description>QuadChroma</description>
  <!-- No elevation; runs with the privileges of the caller. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <!-- Built for Windows 10 and 11 (one GUID for both). -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <asmv3:application>
    <asmv3:windowsSettings>
      <!-- Per-monitor DPI v2 from the start; the same setting that winit (client)
           and host/mod.rs (dpi_bewusst) otherwise make by an API call. -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <!-- Paths longer than 260 characters, if the system allows them. -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <!-- Process code page UTF-8 (Windows 10 1903 and later): the FFmpeg DLLs
           and their C runtime then see UTF-8 in narrow strings. -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </asmv3:windowsSettings>
  </asmv3:application>
</assembly>
