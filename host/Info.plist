<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Identifier of the app. It is part of the signature (designated requirement)
         and therefore of the TCC permissions for Screen Recording and Accessibility:
         changing it means granting both permissions again. Must match BUNDLE in the
         Makefile. -->
    <key>CFBundleIdentifier</key>
    <string>tech.quadchroma.host</string>
    <key>CFBundleName</key>
    <string>QuadChroma</string>
    <key>CFBundleDisplayName</key>
    <string>QuadChroma</string>
    <!-- The one app: the Rust client with the host engine built in (make copies
         client/target/release/quadchroma here). The executable's name is not part
         of the designated requirement - identifier and certificate stay, so the
         TCC permissions survive the change from quadchroma-host. -->
    <key>CFBundleExecutable</key>
    <string>quadchroma</string>
    <!-- The app icon in Contents/Resources (AppIcon.icns, the Makefile copies it from
         client/res). Without it Finder, Dock and Cmd+Tab show the generic icon. -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <!-- Version number shown to users (three numbers). The Makefile reads it for
         the names of the ZIP and the DMG. -->
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <!-- Build number: increase by one before every distributed build (Apple:
         "increment the build version before you distribute a build"). -->
    <key>CFBundleVersion</key>
    <string>3</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 Robert Brandt</string>
    <!-- The app starts without a Dock icon, as a menu bar app: status item,
         menu and small windows (approval request, password, device name). The
         client's window makes it a regular app while it is open (activation
         policy at run time). LSBackgroundOnly would forbid all of that. Neither
         key matters for the signature, Gatekeeper or the TCC permissions (they
         depend on identifier and certificate). -->
    <key>LSUIElement</key>
    <true/>
    <!-- Local network privacy (macOS 15 and later): the app announces itself and
         finds the other computers by UDP broadcast (port 9003) and connects to them
         over TCP; the system asks once and shows this text. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>QuadChroma finds your other computers on the local network and connects to them, and lets them connect to this Mac while sharing is on.</string>
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>
