<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Identifier of the app. It is part of the signature (designated requirement)
         and therefore of the TCC permissions for Screen Recording and Accessibility:
         changing it means granting both permissions again. Must match BUNDLE in the
         Makefile. -->
    <key>CFBundleIdentifier</key>
    <string>tech.quadchroma.host</string>
    <key>CFBundleName</key>
    <string>QuadChroma</string>
    <key>CFBundleDisplayName</key>
    <string>QuadChroma</string>
    <key>CFBundleExecutable</key>
    <string>quadchroma-host</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <!-- Version number shown to users (three numbers). The Makefile reads it for
         the names of the ZIP and the DMG. -->
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <!-- Build number: increase by one before every distributed build (Apple:
         "increment the build version before you distribute a build"). -->
    <key>CFBundleVersion</key>
    <string>2</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 Robert Brandt</string>
    <!-- The host runs without a Dock icon and without windows; this does not
         matter for the signature or Gatekeeper. -->
    <key>LSBackgroundOnly</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>
